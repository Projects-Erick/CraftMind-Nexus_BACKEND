# Gerado automaticamente pelo Railway ao adicionar PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/dbname

NODE_ENV=production
PORT=3001

# URL do seu frontend no Vercel (sem barra no final)
# Exemplo: https://craftmind-nexus.vercel.app
FRONTEND_URL=https://SEU-PROJETO.vercel.app

# JWT — MUDE PARA UM VALOR SECRETO FORTE!
JWT_SECRET=craftmind_nexus_cm_n_2026_by_erick_antunes_berta
JWT_EXPIRES_IN=7d

# Minecraft Plugin
MC_API_KEY=mc_craftmind_secret_key_2024

# Code Execution (Piston — gratuito, sem configuração)
PISTON_API_URL=https://emkc.org/api/v2/piston
